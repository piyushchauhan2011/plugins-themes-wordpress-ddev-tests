# WordPress core (downloaded via DDEV / WP-CLI)
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/xmlrpc.php
/license.txt
/readme.html
/wp-content/index.php
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/uploads
/wp-content/themes/index.php
/wp-content/themes/twenty*/
/wp-content/plugins/*
!/wp-content/plugins/hotel-booking-core/
!/wp-content/plugins/hotel-booking-core/**
# These must come after !** or Git will track generated plugin files.
/wp-content/plugins/hotel-booking-core/node_modules/
/wp-content/plugins/hotel-booking-core/build/
/wp-content/themes/hotel-booking/node_modules/
/wp-content/themes/hotel-booking/build/
/wp-content/plugins/hotel-booking-core/languages/*.mo
/wp-content/plugins/hotel-booking-core/languages/*.l10n.php
/wp-content/plugins/hotel-booking-core/languages/*.json
/wp-content/themes/hotel-booking/languages/*.mo
/wp-content/themes/hotel-booking/languages/*.l10n.php
/wp-content/mu-plugins/
/wp-content/object-cache.php

# Core language packs from `wp language core install` (not theme/plugin catalogs)
/wp-content/languages/

# DDEV-generated WordPress config
/wp-config.php
/wp-config-ddev.php
/.ddev/db_snapshots/

# Composer and WordPress test suite (persisted outside /tmp)
/vendor/
/.wp-tests/

# Fetched on demand by ddev import-theme-unit-test
/content/themeunittestdata.wordpress.xml

.DS_Store
*.log
.phpunit.result.cache

# npm installs (Playwright, plugin, theme, or any nested package)
node_modules/
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
