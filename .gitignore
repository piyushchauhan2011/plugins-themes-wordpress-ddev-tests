/wp-config.php
/wp-config-ddev.php
/.ddev/db_snapshots/

# Composer and WordPress test suite (persisted outside /tmp)
/vendor/
/.wp-tests/

# Fetched on demand by ddev import-theme-unit-test
/content/themeunittestdata.wordpress.xml

.DS_Store
*.log
.phpunit.result.cache

# Playwright (repo-root install). Plugin node_modules is ignored above.
/node_modules/
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
