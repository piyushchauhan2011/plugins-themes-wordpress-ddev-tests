#!/usr/bin/env bash
## Description: Typecheck plugin and theme TypeScript (tsc --noEmit)
## Usage: typecheck
## Example: ddev typecheck

set -euo pipefail

PLUGIN_DIR="${DDEV_APPROOT}/wp-content/plugins/hotel-booking-core"
THEME_DIR="${DDEV_APPROOT}/wp-content/themes/hotel-booking"

cd "${DDEV_APPROOT}"
if [[ ! -d "${PLUGIN_DIR}/node_modules/typescript" ]] || [[ ! -d "${THEME_DIR}/node_modules/typescript" ]]; then
	pnpm install
fi

echo "typecheck (${PLUGIN_DIR})"
pnpm --dir "${PLUGIN_DIR}" run typecheck

echo "typecheck (${THEME_DIR})"
pnpm --dir "${THEME_DIR}" run typecheck
