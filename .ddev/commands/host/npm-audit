#!/usr/bin/env bash
## Description: Audit npm dependencies (high and critical only)
## Usage: npm-audit [npm-audit-args...]
## Example: ddev npm-audit

set -euo pipefail

cd "${DDEV_APPROOT}"

if [[ ! -f package-lock.json ]]; then
	echo "Missing package-lock.json"
	exit 1
fi

if [[ ! -d node_modules ]]; then
	npm ci
fi

npm audit --audit-level=high "$@"
