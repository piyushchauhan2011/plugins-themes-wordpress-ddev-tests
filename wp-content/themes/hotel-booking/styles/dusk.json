{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dusk",
	"styles": {
		"color": {
			"background": "var:preset|color|espresso",
			"text": "var:preset|color|cream"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|gold"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|linen"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|terracotta",
					"text": "var:preset|color|linen"
				}
			}
		}
	}
}
