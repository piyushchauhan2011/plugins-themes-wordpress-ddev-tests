<?php
/**
 * REFERENCE ONLY — not loaded by Hotel Booking Core.
 *
 * Fire-and-forget AMQP publish after MySQL commit. Production should consider
 * a transactional outbox if losing a message is unacceptable.
 *
 * Requires php-amqplib (or ext-amqp) and AMQP_URL in the environment.
 *
 * @package Hotel_Booking_Docs
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * @param string $routing_key inquiry.created|room.updated|…
 * @param array  $payload     JSON-serializable body (ids only, not whole rows).
 */
function hotel_booking_docs_amqp_publish( $routing_key, array $payload ) {
	$url = getenv( 'AMQP_URL' );
	if ( ! is_string( $url ) || '' === $url ) {
		return;
	}

	// PhpAmqpLib\Connection\AMQPStreamConnection::create_from_uri( $url )
	// channel->exchange_declare( 'hotel-booking', 'topic', false, true, false );
	// channel->basic_publish( new AMQPMessage( wp_json_encode( $payload ) ), 'hotel-booking', $routing_key );

	unset( $routing_key, $payload );
}

